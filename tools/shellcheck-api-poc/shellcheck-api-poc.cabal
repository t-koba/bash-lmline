cabal-version: 2.4
name: shellcheck-api-poc
version: 0.1.0.0
license: GPL-3.0-or-later
license-file: LICENSE
build-type: Simple

executable shellcheck-api-poc
  main-is: Main.hs
  default-language: Haskell2010
  ghc-options: -Wall -O1 -threaded -rtsopts -with-rtsopts=-N1
  build-depends:
    base >=4.18 && <4.19,
    ShellCheck ==0.11.0,
    aeson,
    bytestring,
    directory,
    filepath
