# Make required PTY output matches fail closed on timeout or early EOF.
proc expect_required {args} {
  set exact 0
  if {[llength $args] == 2 && [lindex $args 0] eq "-exact"} {
    set exact 1
    set pattern [lindex $args 1]
  } elseif {[llength $args] == 1} {
    set pattern [lindex $args 0]
  } else {
    error {expect_required accepts one pattern, optionally preceded by -exact}
  }

  set timeout_action {puts stderr {timed out waiting for required PTY output}; exit 1}
  set eof_action {puts stderr {PTY process exited before required output}; exit 1}
  if {$exact} {
    expect -exact $pattern {} timeout $timeout_action eof $eof_action
  } else {
    expect $pattern {} timeout $timeout_action eof $eof_action
  }
}

# Explain gate (Bash): the fake engine holds its explain progress/completion
# until this proc releases it via a file under the case config dir, so parent
# scheduling delays cannot skip the transient fallback frame. Bash draws the
# fallback frame straight to the terminal, so releasing on observed spinner
# text "explaining" is causal there, and that observation already proves the
# spinner. The engine waits on the file boundedly and then proceeds, so a
# missing release still finishes instead of hanging. Rewrite callers keep
# their own progress expectations; this gate covers only the explain step.
# Every wait still fails closed on timeout or EOF.
proc expect_required_spinner_and_explanation {release_file} {
  # Preserve messages even if frequent spinner redraws overrun Expect's
  # small default buffer while the async display is finishing.
  match_max 16384
  expect {
    -re {explaining} {}
    timeout {puts stderr {timed out waiting for explain gate trigger}; exit 1}
    eof {puts stderr {PTY process exited before explain gate trigger}; exit 1}
  }
  if {[catch {close [open $release_file w]} err]} {
    puts stderr "failed to release fake engine: $err"
    exit 1
  }
  expect {
    -re {explained pty} {}
    timeout {puts stderr {timed out waiting for explanation}; exit 1}
    eof {puts stderr {PTY process exited before explanation}; exit 1}
  }
}

# Explain gate (Zsh): no Expect-side release. The bridge buffers engine
# output until wait completes, while zle -M spinner text may be displayed
# during the wait; PTY delivery order is not a reliable gate. Instead the test
# wraps __lmline_zsh_hint and writes the release file when the spinner loop
# actually emits the fallback "explaining" hint. The fake engine records
# gated=1 when it observes that file before its bounded wait expires (gated=0
# on fallback timeout, asserted after the PTY run). Expect requires both final
# outputs in either order, without coupling the test to prompt redraw timing.
# Every wait still fails closed on timeout or EOF.
proc expect_required_zsh_explanation {} {
  # The spinner can arrive before the bridge's buffered explanation. Require
  # both messages without assuming their PTY order; gated=1 separately proves
  # the spinner hint released the fake engine before its bounded fallback.
  match_max 16384
  expect {
    -re {(?s)(explained pty.*explaining|explaining.*explained pty)} {}
    timeout {puts stderr {timed out waiting for explanation and spinner}; exit 1}
    eof {puts stderr {PTY process exited before explanation and spinner}; exit 1}
  }
}
