#!/usr/bin/env -S bash -p
# Internal entry: protected Bash startup (`/usr/bin/env -S bash -p` for direct
# invocation, `"$BASH" -p` from the trusted launcher) runs before BASH_ENV/ENV,
# function import, or script code. An explicit unprotected `bash lmline/validate`
# bypasses the shebang; the privileged check below then fails closed but cannot
# undo startup hooks that already ran.
[[ -o privileged ]] || exit 2
__LMLINE_VALIDATE_DIR=${BASH_SOURCE[0]%/*}
# shellcheck source=lmline/validation-boundary.bash
source "$__LMLINE_VALIDATE_DIR/validation-boundary.bash" || exit 2
__LMLINE_CALLER_FUNCTIONS=${LMLINE_SHELL_FUNCTIONS-}
__LMLINE_EXPORTED_FUNCTIONS=${LMLINE_EXPORTED_FUNCTIONS-}
if [[ -z ${LMLINE_EXPORTED_FUNCTIONS+x} ]]; then
  __lmline_inherited_exported=
  export -n __lmline_inherited_exported 2>/dev/null || true
  __lmline_inherited_exported=$(__lmline_collect_inherited_exported_functions) || exit 2
  __LMLINE_EXPORTED_FUNCTIONS=$__lmline_inherited_exported
  unset __lmline_inherited_exported
fi
export -n __LMLINE_CALLER_FUNCTIONS __LMLINE_EXPORTED_FUNCTIONS
unset LMLINE_SHELL_FUNCTIONS LMLINE_EXPORTED_FUNCTIONS
__LMLINE_VALIDATION_ISOLATED=1
source "${BASH_SOURCE[0]%/*}/policy.bash"
case $1 in
  candidate) shift; __lmline_candidate_rejection_reason "$@" ;;
  valid-candidates) shift; __lmline_valid_candidates "$@" ;;
  copilot-request)
    shift
    source "$__LMLINE_POLICY_DIR/actions.bash"
    __lmline_copilot_candidates "$@"
    ;;
  copilot)
    shift
    source "$__LMLINE_POLICY_DIR/actions.bash"
    __lmline_copilot_filter_candidates "$@"
    ;;
  *) exit 2 ;;
esac
