#!/usr/bin/env bash
# Internal entry: always launched with the current trusted Bash and -p.
[[ -o privileged ]] || exit 2
__LMLINE_CALLER_FUNCTIONS=${LMLINE_SHELL_FUNCTIONS-}
__LMLINE_EXPORTED_FUNCTIONS=${LMLINE_EXPORTED_FUNCTIONS-}
export -n __LMLINE_CALLER_FUNCTIONS __LMLINE_EXPORTED_FUNCTIONS
unset LMLINE_SHELL_FUNCTIONS LMLINE_EXPORTED_FUNCTIONS
__LMLINE_VALIDATION_ISOLATED=1
source "${BASH_SOURCE[0]%/*}/policy.bash"
case $1 in
  candidate) shift; __lmline_candidate_rejection_reason "$@" ;;
  valid-candidates) shift; __lmline_valid_candidates "$@" ;;
  copilot-request)
    shift
    source "$__LMLINE_POLICY_DIR/actions.bash"
    __lmline_copilot_candidates "$@"
    ;;
  copilot)
    shift
    source "$__LMLINE_POLICY_DIR/actions.bash"
    __lmline_copilot_filter_candidates "$@"
    ;;
  *) exit 2 ;;
esac
