      subcommands) [[ "${3-}" == -h || "${3-}" == --help || -z "${3-}" ]] && { print_cli_help complete subcommands; exit 0; }; __lmline_cli_subcommands "${3-}" ;;
      settings) [[ "${3-}" == -h || "${3-}" == --help ]] && { print_cli_help complete settings; exit 0; }; __lmline_setting_keys ;;
      setting-values) [[ "${3-}" == -h || "${3-}" == --help || -z "${3-}" ]] && { print_cli_help complete setting-values; exit 0; }; __lmline_setting_value_candidates "${3-}" ;;
      endpoints) [[ "${3-}" == -h || "${3-}" == --help ]] && { print_cli_help complete endpoints; exit 0; }; [[ -f "$endpoints_file" ]] && awk -F '\t' 'NF && $1 !~ /^#/ { print $1 }' "$endpoints_file" ;;
      models) [[ "${3-}" == -h || "${3-}" == --help ]] && { print_cli_help complete models; exit 0; }; profile_model_list "${3-}" | awk -F '\t' '{ print $2 }' ;;
