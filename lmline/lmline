    *) return 1 ;;
  esac
}

__lmline_config_file_op() {
  local op=$1 file=$2 key=$3 value=${4-} tmp
  [[ "$key" =~ ^LMLINE_[A-Z0-9_]+$ ]] || {
    printf 'lmline: invalid key: %s\n' "$key" >&2
    exit 2
  }
  case "$op" in
    set)
      mkdir -p "${file%/*}"
      touch "$file"
      __lmline_mktemp tmp "${TMPDIR:-/tmp}/lmline-cfg.XXXXXX"
      grep -v -E "^export ${key}=" "$file" >"$tmp" || true
      printf 'export %s=%s\n' "$key" "$(quote_bash "$value")" >>"$tmp"
      grep -qxF "export ${key}=$(quote_bash "$value")" "$tmp" || {
        printf 'lmline: failed to write %s\n' "$key" >&2
        exit 1
      }
      mv "$tmp" "$file"
      chmod 600 "$file" 2>/dev/null || true
      ;;
    unset)
      [[ -f "$file" ]] || return 0
      __lmline_mktemp tmp "${TMPDIR:-/tmp}/lmline-cfg.XXXXXX"
      grep -v -E "^export ${key}=" "$file" >"$tmp" || true
      ! grep -qE "^export ${key}=" "$tmp" || {
        printf 'lmline: failed to remove %s\n' "$key" >&2
        exit 1
      }
      mv "$tmp" "$file"
      chmod 600 "$file" 2>/dev/null || true
      ;;
    *) return 2 ;;
  esac
}

# Runs a mutating command while holding the config-dir lock so concurrent
# lmline invocations cannot interleave their read-modify-write cycles. The
# wrapped command must not take the lock again; the EXIT trap releases the
# lock if the command exits early.
with_config_lock() {
  __lmline_lock_acquire "$config_dir/.lmline.lock" "${LMLINE_LOCK_TIMEOUT:-5}" || exit 1
  __lmline_lock_path=$config_dir/.lmline.lock
  "$@"
  __lmline_lock_release "$__lmline_lock_path"
  __lmline_lock_path=
}

write_config_value() {
  __lmline_config_file_op set "$config_file" "$1" "$2"
}

unset_config_value() {
  __lmline_config_file_op unset "$config_file" "$1"
}

print_config_redacted() {
  local file=${1:-$config_file}
  [[ -f "$file" ]] || return 0
  sed -E \
    -e 's/^(export LMLINE_[A-Z0-9_]*(TOKEN|SECRET|PASSWORD|PASS|KEY)=).*/\1***REDACTED***/' \
    "$file"
}

source_support_files() {
  local file
  for file in policy.bash sandbox.bash context.bash actions.bash; do
    [[ -r "$script_dir/$file" ]] || {
      printf 'lmline: required support file missing: %s\n' "$script_dir/$file" >&2
      exit 1
    }
  done
  # shellcheck source=lmline/policy.bash
  source "$script_dir/policy.bash"
  # shellcheck source=lmline/sandbox.bash
  source "$script_dir/sandbox.bash"
  # shellcheck source=lmline/context.bash
  source "$script_dir/context.bash"
  # shellcheck source=lmline/actions.bash
  source "$script_dir/actions.bash"
}

engine_path() {
  if [[ -n "${LMLINE_ENGINE:-}" ]]; then
    printf '%s\n' "$LMLINE_ENGINE"
  else
    printf '%s\n' "$script_dir/engine"
  fi
}

print_explanation() {
  local line=$1
  source_support_files
  printf 'Explaining...\n' >&2
  __lmline_print_explanation "$(engine_path)" bash "$line" "${#line}" "$LMLINE_PS0"
}

print_clip() {
  local question=$1
  source_support_files
  __lmline_print_clip "$(engine_path)" bash "$question" "$LMLINE_PS0"
}

print_sandbox_check() {
  source_support_files
  __lmline_microsandbox_check
}

run_sandbox_command() {
  local image= name= timeout=${LMLINE_TOOL_COMMAND_RUN_TIMEOUT:-3} max_output=${LMLINE_TOOL_COMMAND_RUN_MAX_OUTPUT:-12000}
  local tmp status command_line
  while (($#)); do
    case "$1" in
      --name)
        name=${2-}
        [[ -n "$name" ]] || { printf 'lmline: sandbox run --name requires NAME\n' >&2; return 2; }
        shift 2
        ;;
      --image)
        image=${2-}
        [[ -n "$image" ]] || { printf 'lmline: sandbox run --image requires IMAGE\n' >&2; return 2; }
        shift 2
        ;;
      --timeout)
        timeout=${2-}
        [[ "$timeout" =~ ^[1-9][0-9]*$ ]] || { printf 'lmline: sandbox run --timeout requires positive seconds\n' >&2; return 2; }
        shift 2
        ;;
      --max-output)
        max_output=${2-}
        [[ "$max_output" =~ ^[1-9][0-9]*$ ]] || { printf 'lmline: sandbox run --max-output requires positive bytes\n' >&2; return 2; }
        shift 2
        ;;
      --)
        shift
        break
        ;;
      *)
        printf 'lmline: sandbox run requires -- before COMMAND\n' >&2
        return 2
        ;;
    esac
  done
  (($# > 0)) || { printf 'lmline: sandbox run requires COMMAND\n' >&2; return 2; }
  command_line=$*
  source_support_files
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/lmline-sandbox-run.XXXXXX") || return 1
  [[ -n "$name" ]] && LMLINE_MICROSANDBOX_NAME=$name
  [[ -n "$image" ]] && LMLINE_MICROSANDBOX_IMAGE=$image
  if ! __lmline_microsandbox_available; then
    rm -rf "$tmp"
    printf 'lmline: microsandbox CLI is unavailable; install msb or set LMLINE_MICROSANDBOX_COMMAND\n' >&2
    return 1
  fi
  if ! __lmline_run_command_capture_with_backend microsandbox "$command_line" "$timeout" "$tmp/stdout" "$tmp/stderr"; then
    printf 'lmline: sandbox command failed before execution: %s\n' "${__LMLINE_EXEC_ERROR:-unknown}" >&2
    [[ -s "$tmp/stderr" ]] && sed -n '1,10p' "$tmp/stderr" >&2
    rm -rf "$tmp"
    return 1
  fi
  __lmline_condense_file "$tmp/stdout" "$max_output"
  __lmline_condense_file "$tmp/stderr" "$max_output"
  cat "$tmp/stdout"
  cat "$tmp/stderr" >&2
  status=$__LMLINE_EXEC_STATUS
  rm -rf "$tmp"
  return "$status"
}

setup_sandbox() {
  local name=${LMLINE_MICROSANDBOX_NAME:-} image=${LMLINE_MICROSANDBOX_IMAGE:-debian}
  local workspace_mode=${LMLINE_MICROSANDBOX_WORKSPACE_MODE:-readonly}
  local root= root_arg= workdir=${LMLINE_MICROSANDBOX_WORKDIR:-/workspace} timeout=${LMLINE_MICROSANDBOX_SETUP_TIMEOUT:-30}
  while (($#)); do
    case "$1" in
      --name)
        name=${2-}
        [[ -n "$name" ]] || { printf 'lmline: sandbox setup --name requires NAME\n' >&2; return 2; }
        shift 2
        ;;
      --image)
        image=${2-}
        [[ -n "$image" ]] || { printf 'lmline: sandbox setup --image requires IMAGE\n' >&2; return 2; }
        shift 2
        ;;
      --workspace)
        workspace_mode=${2-}
        case "$workspace_mode" in readonly|writable|none) ;; *) printf 'lmline: sandbox setup --workspace expects readonly, writable, or none\n' >&2; return 2 ;; esac
        shift 2
        ;;
      --root)
        root_arg=${2-}
        [[ -n "$root_arg" ]] || { printf 'lmline: sandbox setup --root requires PATH\n' >&2; return 2; }
        shift 2
        ;;
      --workdir)
        workdir=${2-}
        [[ "$workdir" == /* ]] || { printf 'lmline: sandbox setup --workdir requires an absolute guest path\n' >&2; return 2; }
        shift 2
        ;;
      --timeout)
        timeout=${2-}
        [[ "$timeout" =~ ^[1-9][0-9]*$ ]] || { printf 'lmline: sandbox setup --timeout requires positive seconds\n' >&2; return 2; }
        shift 2
        ;;
      *)
        printf 'lmline: unknown sandbox setup option: %s\n' "$1" >&2
        return 2
        ;;
    esac
  done
  source_support_files
  if [[ -n "$root_arg" ]]; then
    root=$(cd -P -- "$root_arg" 2>/dev/null && pwd -P) || { printf 'lmline: sandbox setup root not found: %s\n' "$root_arg" >&2; return 2; }
  else
    root=$(__lmline_project_root_for_sandbox) || return 1
  fi
  [[ -n "$name" ]] || name=$(__lmline_default_sandbox_name "$root")
  __lmline_microsandbox_setup "$name" "$image" "$workspace_mode" "$root" "$workdir" "$timeout" || return $?
  cat <<EOF
next_config:
  lmline config project-set LMLINE_EXEC_BACKEND microsandbox
  lmline config project-set LMLINE_MICROSANDBOX_COMMAND $(quote_bash "${LMLINE_MICROSANDBOX_COMMAND:-msb}")
  lmline config project-set LMLINE_MICROSANDBOX_NAME $(quote_bash "$name")
  lmline config project-set LMLINE_MICROSANDBOX_WORKDIR $(quote_bash "$workdir")
EOF
}

print_command_status() {
  local file=$1 c
  while IFS= read -r c; do
    if command -v "$c" >/dev/null 2>&1; then
      printf 'ok command=%s path=%s\n' "$c" "$(command -v "$c")"
    else
      printf 'missing command=%s\n' "$c"
      printf '  -> install %s or check PATH\n' "$c"
    fi
  done < <(__lmline_read_list_file "$file")
}

cmd=${1-}
case "$cmd" in
  doctor)
    shift || true
    [[ "${1-}" == -h || "${1-}" == --help ]] && { print_cli_help doctor; exit 0; }
    source_support_files
    resolved_engine=$(engine_path)
    printf 'config_dir=%s\n' "$config_dir"
    if [[ -x "$resolved_engine" ]]; then
      printf 'engine=%s (ok)\n' "$resolved_engine"
    elif [[ -e "$resolved_engine" ]]; then
      printf 'engine=%s (not executable)\n' "$resolved_engine"
    else
      printf 'engine=NOT FOUND\n'
    fi
    printf 'base_url=%s\n' "${LMLINE_BASE_URL:-not-configured}"
    printf 'model=%s\n' "${LMLINE_MODEL:-auto-discover}"
    if [[ -n "${LMLINE_API_KEY_FILE:-}" ]]; then
      printf 'auth=configured\n'
    else
      printf 'auth=not-configured\n'
      printf '  -> lmline endpoint set-secret ENDPOINT\n'
    fi
    printf '\nrequired_commands\n'
    required_file=$(__lmline_resolve_data_file doctor_required_commands \
      "${LMLINE_DOCTOR_REQUIRED_COMMANDS_FILE:-}" \
      "$LMLINE_USER_RULES_DIR/doctor_required_commands.txt" \
      "$LMLINE_DEFAULTS_DIR/doctor_required_commands.txt") || exit 1
    print_command_status "$required_file"
    printf '\noptional_commands\n'
    optional_file=$(__lmline_resolve_data_file doctor_optional_commands \
      "${LMLINE_DOCTOR_OPTIONAL_COMMANDS_FILE:-}" \
      "$LMLINE_USER_RULES_DIR/doctor_optional_commands.txt" \
      "$LMLINE_DEFAULTS_DIR/doctor_optional_commands.txt") || exit 1
    print_command_status "$optional_file"
    printf '\nprofiles\n'
    endpoint_count=0
    model_count=0
    [[ -f "$endpoints_file" ]] && endpoint_count=$(awk -F '\t' 'NF && $1 !~ /^#/ { c++ } END { print c+0 }' "$endpoints_file")
    [[ -f "$models_file" ]] && model_count=$(awk -F '\t' 'NF && $1 !~ /^#/ { c++ } END { print c+0 }' "$models_file")
    printf 'endpoints=%s\nmodels=%s\n' "$endpoint_count" "$model_count"
    profile_current | sed 's/^/active_/'
    printf '\ndefaults\n'
    for f in \
      command_prefix_words.txt \
      clipboard_providers.tsv \
      condense_priority_patterns.txt \
      doctor_optional_commands.txt \
      doctor_required_commands.txt \
      file_search_excludes.txt \
      local_commands.txt \
      project_markers.tsv \
      risk_patterns.tsv \
      shell_syntax_words.txt \
      suggested_commands.txt; do
      if [[ -r "$LMLINE_DEFAULTS_DIR/$f" ]]; then
        printf '  %s: ok\n' "$f"
      else
        printf '  %s: MISSING\n' "$f"
      fi
    done
    if [[ "${1-}" == "--check-api" ]]; then
      printf '\napi_check\n'
      api_base=${LMLINE_BASE_URL:-}
      __lmline_mktemp api_header_tmp "${TMPDIR:-/tmp}/lmline-hdr.XXXXXX"
      # ${VAR-default} (no colon): an explicitly empty scheme means raw key.
      __lmline_http_build_headers "${LMLINE_API_KEY_FILE:-}" \
        "${LMLINE_AUTH_HEADER:-Authorization}" "${LMLINE_AUTH_SCHEME-Bearer}" "$api_header_tmp"
      if [[ -n "$api_base" ]] && __lmline_http_get "$(profile_model_catalog_url "$api_base" "${LMLINE_MODELS_URL:-}")" 5 >/dev/null 2>&1; then
        printf '  connection=ok\n'
      else
        printf '  connection=failed\n'
        printf '  -> check LMLINE_BASE_URL or run: lmline use ENDPOINT MODEL\n'
      fi
    fi
    printf '\nclipboard\n'
    __lmline_clipboard_status
    ;;
  context)
    shift || true
    [[ "${1-}" == -h || "${1-}" == --help ]] && { print_cli_help context; exit 0; }
    source_support_files
    __lmline_mktemp tmp "${TMPDIR:-/tmp}/lmline-ctx.XXXXXX"
    __lmline_context_file "$tmp" "$*"
    cat "$tmp"
    ;;
  commands)
    shift || true
    [[ "${1-}" == -h || "${1-}" == --help ]] && { print_cli_help commands; exit 0; }
    source_support_files
    __lmline_tool_commands "$*"
    ;;
  command-exists)
    shift || true
    [[ "${1-}" == -h || "${1-}" == --help ]] && { print_cli_help command-exists; exit 0; }
    source_support_files
    __lmline_tool_command_exists "$*"
    ;;
  command-info)
    shift || true
    [[ "${1-}" == -h || "${1-}" == --help ]] && { print_cli_help command-info; exit 0; }
    source_support_files
    __lmline_tool_command_info "$*"
    ;;
  payload)
    shift || true
    [[ "${1-}" == -h || "${1-}" == --help ]] && { print_cli_help payload; exit 0; }
    mode=${1-}
    case "${1-}" in
      generate|rewrite|explain|fix|clip)
        shift
        [[ "${1-}" == -h || "${1-}" == --help ]] && { print_cli_help payload "$mode"; exit 0; }
        ;;
      *)
        printf 'lmline: invalid payload mode: %s (expected generate, rewrite, explain, fix, or clip)\n' "${1-}" >&2
        exit 2
        ;;
    esac
    line=$*
    source_support_files
    __lmline_mktemp_dir tmp "${TMPDIR:-/tmp}/lmline-payload.XXXXXX"
    printf '%s' "$line" >"$tmp/line"
    __lmline_context_file "$tmp/context" "$line" "$mode"
    "$(engine_path)" --dry-run-payload --mode "$mode" --shell bash --cwd "$PWD" --point "${#line}" --line-file "$tmp/line" --context-file "$tmp/context" --n "$LMLINE_CANDIDATE_COUNT"
    ;;
  sandbox)
    sub=${2-}
    case "$sub" in
      -h|--help) print_cli_help sandbox; exit 0 ;;
      '') print_cli_help sandbox; exit 2 ;;
    esac
    shift 2 || true
    case "$sub" in
      setup) [[ "${1-}" == -h || "${1-}" == --help ]] && { print_cli_help sandbox setup; exit 0; }; setup_sandbox "$@" ;;
      run) [[ "${1-}" == -h || "${1-}" == --help ]] && { print_cli_help sandbox run; exit 0; }; run_sandbox_command "$@" ;;
      check) [[ "${1-}" == -h || "${1-}" == --help ]] && { print_cli_help sandbox check; exit 0; }; print_sandbox_check ;;
      *) usage; exit 2 ;;
    esac
    ;;
  clip)
    shift || true
    [[ "${1-}" == -h || "${1-}" == --help ]] && { print_cli_help clip; exit 0; }
    source_support_files
    case "${1-}" in
      --status)
        __lmline_clipboard_status
        ;;
      --providers)
        __lmline_clipboard_provider_list
        ;;
      --use)
        provider=${2-}
        [[ -n "$provider" ]] || { printf 'lmline: clip --use requires PROVIDER\n' >&2; exit 2; }
        if [[ "$provider" != auto ]]; then
          LMLINE_CLIPBOARD_PROVIDER=$provider __lmline_clipboard_provider_line >/dev/null || exit 1
        fi
        with_config_lock write_config_value LMLINE_CLIPBOARD_PROVIDER "$provider"
        LMLINE_CLIPBOARD_PROVIDER=$provider __lmline_clipboard_status
        ;;
      --provider)
        provider=${2-}
        [[ -n "$provider" ]] || { printf 'lmline: clip --provider requires PROVIDER\n' >&2; exit 2; }
        shift 2
        LMLINE_CLIPBOARD_PROVIDER=$provider print_clip "$*"
        ;;
      *)
        print_clip "$*"
        ;;
    esac
    ;;
  config)
    sub=${2-}; shift 2 || true
    case "$sub" in
      -h|--help|'') print_cli_help config; [[ -n "$sub" ]] && exit 0 || exit 2 ;;
    esac
    case "$sub" in
      get) [[ "${1-}" == -h || "${1-}" == --help ]] && { print_cli_help config get; exit 0; }; print_config_redacted ;;
      defaults) [[ "${1-}" == -h || "${1-}" == --help ]] && { print_cli_help config defaults; exit 0; }; print_config_defaults ;;
      effective) [[ "${1-}" == -h || "${1-}" == --help ]] && { print_cli_help config effective; exit 0; }; print_config_effective ;;
      describe) [[ "${1-}" == -h || "${1-}" == --help ]] && { print_cli_help config describe; exit 0; }; print_config_describe "${1-}" ;;
      set)
        [[ "${1-}" == -h || "${1-}" == --help ]] && { print_cli_help config set; exit 0; }
        key=${1-}; value=${2-}
        # An explicitly empty VALUE is allowed (e.g. LMLINE_AUTH_SCHEME='' for
        # raw-header authentication); the argument must still be present.
        [[ "$key" =~ ^LMLINE_[A-Z0-9_]+$ && $# -ge 2 ]] || {
          printf 'lmline: config set requires KEY like LMLINE_MODEL and VALUE\n' >&2
          exit 2
        }
        with_config_lock write_config_value "$key" "$value"
        ;;
      unset)
        [[ "${1-}" == -h || "${1-}" == --help ]] && { print_cli_help config unset; exit 0; }
        key=${1-}
        [[ -n "$key" ]] || { usage; exit 2; }
        with_config_lock unset_config_value "$key"
        ;;
      project-get)
        [[ "${1-}" == -h || "${1-}" == --help ]] && { print_cli_help config project-get; exit 0; }
        print_config_redacted "$PWD/.lmline.bash"
        ;;
      project-set)
        [[ "${1-}" == -h || "${1-}" == --help ]] && { print_cli_help config project-set; exit 0; }
        key=${1-}; value=${2-}
        [[ "$key" =~ ^LMLINE_[A-Z0-9_]+$ && $# -ge 2 ]] || {
          printf 'lmline: config project-set requires KEY like LMLINE_MODEL and VALUE\n' >&2
          exit 2
        }
        with_config_lock __lmline_config_file_op set "$PWD/.lmline.bash" "$key" "$value"
        ;;
      project-unset)
        [[ "${1-}" == -h || "${1-}" == --help ]] && { print_cli_help config project-unset; exit 0; }
        key=${1-}
        [[ -n "$key" ]] || { usage; exit 2; }
        with_config_lock __lmline_config_file_op unset "$PWD/.lmline.bash" "$key"
        ;;
      *) usage; exit 2 ;;
    esac
    ;;
  endpoint)
    sub=${2-}; shift 2 || true
    case "$sub" in -h|--help|'') print_cli_help endpoint; [[ -n "$sub" ]] && exit 0 || exit 2 ;; esac
    case "$sub" in
      add) [[ "${1-}" == -h || "${1-}" == --help ]] && { print_cli_help endpoint add; exit 0; }; with_config_lock profile_endpoint_add "$@" ;;
      list) [[ "${1-}" == -h || "${1-}" == --help ]] && { print_cli_help endpoint list; exit 0; }; profile_endpoint_list ;;
      set-secret) [[ "${1-}" == -h || "${1-}" == --help ]] && { print_cli_help endpoint set-secret; exit 0; }; with_config_lock profile_endpoint_set_secret "${1-}" "${2-}" ;;
      remove) [[ "${1-}" == -h || "${1-}" == --help ]] && { print_cli_help endpoint remove; exit 0; }; with_config_lock profile_endpoint_remove "$@" ;;
      *) usage; exit 2 ;;
    esac
    ;;
  model)
    sub=${2-}; shift 2 || true
    case "$sub" in -h|--help|'') print_cli_help model; [[ -n "$sub" ]] && exit 0 || exit 2 ;; esac
    case "$sub" in
      add) [[ "${1-}" == -h || "${1-}" == --help ]] && { print_cli_help model add; exit 0; }; with_config_lock profile_model_add "$@" ;;
      list) [[ "${1-}" == -h || "${1-}" == --help ]] && { print_cli_help model list; exit 0; }; profile_model_list "${1-}" ;;
      refresh) [[ "${1-}" == -h || "${1-}" == --help ]] && { print_cli_help model refresh; exit 0; }; with_config_lock profile_model_refresh "${1-}" ;;
