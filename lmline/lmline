    case "${2-}" in -h|--help|'') print_cli_help history; [[ -n "${2-}" ]] && exit 0 || exit 2 ;; esac
    case "${2-}" in
      show)
        [[ "${3-}" == -h || "${3-}" == --help ]] && { print_cli_help history show; exit 0; }
        if [[ -d "$history_dir" ]]; then
          find "$history_dir" -maxdepth 1 -type f -print -exec tail -n 40 {} \;
