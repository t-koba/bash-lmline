    context:) cat <<'EOF'
usage: lmline context [LINE...]

Print the shell context that would be sent to the engine for LINE.
EOF
      ;;
    command-exists:) cat <<'EOF'
usage: lmline command-exists COMMAND...

Check whether named commands are available locally.
EOF
      ;;
    command-info:) cat <<'EOF'
usage: lmline command-info COMMAND...

Print local command path, kind, type output, version, and help snippets.
EOF
      ;;
    commands:) cat <<'EOF'
usage: lmline commands [QUERY]

Print local command names matching QUERY.
EOF
      ;;
    payload:) cat <<'EOF'
usage: lmline payload generate|rewrite|explain|fix|clip [LINE...]

Print the OpenAI-compatible request payload without sending it.
EOF
      ;;
    payload:generate|payload:rewrite|payload:explain|payload:fix|payload:clip) cat <<'EOF'
usage: lmline payload MODE [LINE...]

