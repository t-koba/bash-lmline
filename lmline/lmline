__lmline_setting_keys() {
  __lmline_setting_catalog | awk -F '\t' 'NF >= 1 { print $1 }'
}

__lmline_setting_catalog_line() {
  local wanted=$1
  __lmline_setting_catalog | awk -F '\t' -v wanted="$wanted" '$1 == wanted { print; found=1; exit } END { if (!found) exit 1 }'
}

__lmline_setting_value_candidates() {
  case "$1" in
    LMLINE_EXEC_BACKEND) printf '%s\n' auto local microsandbox off ;;
    LMLINE_MICROSANDBOX_WORKSPACE_MODE) printf '%s\n' readonly writable none ;;
    LMLINE_API_FORMAT) printf '%s\n' chat responses messages ;;
    LMLINE_TOOL_MODE) printf '%s\n' auto openai text none ;;
    LMLINE_TOOL_CHOICE) printf '%s\n' auto none ;;
    LMLINE_STATUS_MODE) printf '%s\n' inline transient log debug silent none ;;
    LMLINE_EXPLAIN_DETAIL) printf '%s\n' brief normal detailed ;;
    LMLINE_TOOL_COMMAND_RUN_MAX_RISK) printf '%s\n' low medium high ;;
    LMLINE_CLIPBOARD_PROVIDER) source_support_files; printf 'auto\n'; __lmline_clipboard_provider_names ;;
    LMLINE_BIND_KEYS|LMLINE_ASYNC|LMLINE_STREAM|LMLINE_TOOL_RESULT_SUMMARIZE|LMLINE_INCLUDE_SHELL_CONTEXT|LMLINE_INCLUDE_CWD_CONTEXT|LMLINE_INCLUDE_GIT_CONTEXT|LMLINE_INCLUDE_PROJECT_CONTEXT|LMLINE_INCLUDE_EDITOR_CONTEXT|LMLINE_INCLUDE_LOCALE_CONTEXT|LMLINE_INCLUDE_SUGGESTED_COMMANDS|LMLINE_TOOL_COMMAND_EXISTS|LMLINE_TOOL_COMMANDS|LMLINE_TOOL_COMMAND_INFO|LMLINE_TOOL_FILES|LMLINE_TOOL_GIT_STATUS|LMLINE_TOOL_FILE_EXCERPT|LMLINE_TOOL_COMMAND_RUN|LMLINE_SPINNER|LMLINE_PROGRESS|LMLINE_DEBUG|LMLINE_FIX_ALLOW_MEDIUM|LMLINE_EXPERIMENTAL_DEFAULT_COMPLETION)
      printf '%s\n' 0 1
      ;;
  esac
}

__lmline_redact_setting_value() {
  local key=$1 value=$2
  case "$key" in
    *TOKEN*|*SECRET*|*PASSWORD*|*PASS*|*KEY*)
      [[ -n "$value" ]] && printf '***REDACTED***'
      ;;
    *) printf '%s' "$value" ;;
  esac
}

__lmline_effective_setting_value() {
  local key=$1 default=$2 value
  case "$key" in
    LMLINE_CONFIG_DIR) value=$config_dir ;;
    LMLINE_HISTORY_DIR) value=$history_dir ;;
    LMLINE_DEFAULTS_DIR) value=${LMLINE_DEFAULTS_DIR:-$script_dir/defaults} ;;
    LMLINE_USER_RULES_DIR) value=${LMLINE_USER_RULES_DIR:-$config_dir} ;;
    LMLINE_ENGINE) value=$(engine_path) ;;
    LMLINE_PROMPT_DIR) value=${LMLINE_PROMPT_DIR:-$script_dir/prompts} ;;
    LMLINE_BIN_DIR) value=${LMLINE_BIN_DIR:-$HOME/.local/bin} ;;
    *)
      if [[ ${!key+x} ]]; then
        value=${!key}
      else
        value=$default
      fi
      ;;
  esac
  [[ "$value" == empty ]] && value=
  printf '%s' "$value"
}

print_config_defaults() {
  printf 'setting\tdefault\tdescription\n'
  __lmline_setting_catalog
}

print_config_effective() {
  local key default description value
  printf 'setting\tvalue\tdefault\tdescription\n'
  while IFS=$'\t' read -r key default description; do
    value=$(__lmline_effective_setting_value "$key" "$default")
    printf '%s\t%s\t%s\t%s\n' "$key" "$(__lmline_redact_setting_value "$key" "$value")" "$default" "$description"
  done < <(__lmline_setting_catalog)
}

print_config_describe() {
  local key=${1-} line default description value values
  [[ -n "$key" ]] || { printf 'lmline: config describe requires KEY\n' >&2; return 2; }
  line=$(__lmline_setting_catalog_line "$key") || {
    printf 'lmline: unknown setting: %s\n' "$key" >&2
    return 2
  }
  IFS=$'\t' read -r key default description <<<"$line"
  value=$(__lmline_effective_setting_value "$key" "$default")
  values=$(__lmline_setting_value_candidates "$key" | paste -sd ' ' - 2>/dev/null || true)
  printf 'setting=%s\n' "$key"
  printf 'value=%s\n' "$(__lmline_redact_setting_value "$key" "$value")"
  printf 'default=%s\n' "$default"
  [[ -n "$values" ]] && printf 'values=%s\n' "$values"
  printf 'description=%s\n' "$description"
}

